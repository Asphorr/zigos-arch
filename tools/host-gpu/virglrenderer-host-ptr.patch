+            .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT,
+         };
+         const VkMemoryAllocateInfo probe_info = {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .pNext = &export_info,
+            .allocationSize = 64 * 1024,
+            .memoryTypeIndex = mem_type_index,
+         };
