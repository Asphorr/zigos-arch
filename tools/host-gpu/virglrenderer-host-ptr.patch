+/* Driver memory whose CPU mapping a VMM-side resource still maps into the
+ * guest, after the guest freed the VkDeviceMemory.
+ */
+struct vkr_host_ptr_zombie {
+   struct list_head head;
+   uint32_t res_id;
+   struct vkr_device *device;
+   VkDeviceMemory memory;
+   void *ptr;
+   size_t size;
+};
+
+/* Returns true if the driver memory must outlive the guest's vkFreeMemory. */
+static bool
+vkr_device_memory_defer_free(struct vkr_context *ctx, struct vkr_device_memory *mem)
+{
+   bool deferred = false;
+
+   mtx_lock(&ctx->host_ptr_mutex);
+   struct vkr_resource *res =
+      mem->host_ptr_res_id ? vkr_context_get_resource(ctx, mem->host_ptr_res_id) : NULL;
+   if (res && res->host_ptr_mem == mem) {
+      struct vkr_host_ptr_zombie *zombie = calloc(1, sizeof(*zombie));
+      if (zombie) {
+         zombie->res_id = res->res_id;
+         zombie->device = mem->device;
+         zombie->memory = mem->base.handle.device_memory;
+         zombie->ptr = mem->host_ptr;
+         zombie->size = mem->allocation_size;
+         list_addtail(&zombie->head, &ctx->host_ptr_zombies);
+         res->host_ptr_mem = NULL;
+         deferred = true;
+      } else {
+         vkr_log("cannot defer freeing host ptr mem of res %u", res->res_id);
+      }
+   }
+   mtx_unlock(&ctx->host_ptr_mutex);
+
+   return deferred;
+}
+
+void *
+vkr_device_memory_detach_resource(struct vkr_context *ctx,
+                                  struct vkr_device_memory *mem,
+                                  size_t *out_size)
+{
+   void *still_mapped = NULL;
+
+   if (!mem->host_ptr_only)
+      return NULL;
+
+   mtx_lock(&ctx->host_ptr_mutex);
+   if (mem->host_ptr_res_id) {
+      struct vkr_resource *res = vkr_context_get_resource(ctx, mem->host_ptr_res_id);
+      if (res && res->host_ptr_mem == mem) {
+         vkr_log("freeing memory that res %u still maps", res->res_id);
+         res->host_ptr_mem = NULL;
+         still_mapped = mem->host_ptr;
+         *out_size = mem->allocation_size;
+      }
+      mem->host_ptr_res_id = 0;
+   }
+   mtx_unlock(&ctx->host_ptr_mutex);
+
+   return still_mapped;
+}
+
+void
+vkr_device_memory_backfill_mapping(void *ptr, size_t size)
+{
+   /* The VMM keeps pointing here until the resource goes away: back the hole
+    * with zero pages so a guest access cannot fault the host.
+    */
+   /* EEXIST: the driver kept the range mapped (dzn caches heaps), still valid */
+   if (mmap(ptr, size, PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0) == MAP_FAILED &&
+       errno != EEXIST)
+      vkr_log("cannot backfill freed host ptr mapping %p (%s)", ptr, strerror(errno));
+}
+
+void
+vkr_device_memory_on_resource_destroy(struct vkr_context *ctx, struct vkr_resource *res)
+{
+   if (res->fd_type != VIRGL_RESOURCE_HOST_PTR)
+      return;
+
+   mtx_lock(&ctx->host_ptr_mutex);
+   if (res->host_ptr_mem) {
+      /* the guest still owns the memory; vkFreeMemory releases it as usual */
+      res->host_ptr_mem->host_ptr_res_id = 0;
+      res->host_ptr_mem = NULL;
+   } else {
+      list_for_each_entry_safe (struct vkr_host_ptr_zombie, zombie, &ctx->host_ptr_zombies,
+                                head) {
+         if (zombie->res_id != res->res_id)
+            continue;
+         zombie->device->proc_table.FreeMemory(zombie->device->base.handle.device,
+                                               zombie->memory, NULL);
+         list_del(&zombie->head);
+         free(zombie);
+         break;
+      }
+   }
+   mtx_unlock(&ctx->host_ptr_mutex);
+}
+
+void
+vkr_device_memory_release_zombies(struct vkr_context *ctx, struct vkr_device *dev)
+{
+   mtx_lock(&ctx->host_ptr_mutex);
+   list_for_each_entry_safe (struct vkr_host_ptr_zombie, zombie, &ctx->host_ptr_zombies,
+                             head) {
+      if (dev && zombie->device != dev)
+         continue;
+      vkr_log("device going away while res %u still maps its memory", zombie->res_id);
+      zombie->device->proc_table.FreeMemory(zombie->device->base.handle.device,
+                                            zombie->memory, NULL);
+      vkr_device_memory_backfill_mapping(zombie->ptr, zombie->size);
+      list_del(&zombie->head);
+      free(zombie);
+   }
+   mtx_unlock(&ctx->host_ptr_mutex);
 }
 
