+      dev->host_visible_export_probed |= bit;
+      if (ok)
+         dev->host_visible_export_ok |= bit;
+      vkr_log("memory type %u: host-visible export %s", mem_type_index,
+              ok ? "ok" : "unavailable, mapping via host pointers");
+   }
+   const bool ok = dev->host_visible_export_ok & bit;
+   mtx_unlock(&dev->object_mutex);
+   return ok;
